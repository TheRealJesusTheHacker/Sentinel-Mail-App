    <!-- settings prose -->
    <string name="settings_account_line">Connected directly to mail.sentinelsafeguard.net (IMAP 993, submission 587). Your password lives only in this phone\'s secure storage.</string>
    <string name="settings_checks_explainer">Sentinel Mail checks the server on a timer and lets you know when new mail arrives. It is periodic checking — mail is not pushed to the phone.</string>
    <string name="settings_checks_hour">Every hour</string>
    <string name="settings_checks_manual_long">Manual only — check when you open a folder</string>
    <string name="settings_lock_line">Lock Sentinel Mail</string>
    <string name="settings_lock_explainer">Ask for biometrics, your device unlock, or your app PIN when the app comes back after about five minutes away.</string>
    <string name="settings_pin_dialog_title">App PIN</string>
    <string name="settings_pin_explainer">At least 4 digits. The PIN is never stored — only a scrambled check of it.</string>
    <string name="settings_pin_new">New PIN</string>
    <string name="settings_pin_repeat">Repeat PIN</string>
    <string name="settings_pin_save">Save PIN</string>
    <string name="settings_pin_short">Use at least 4 digits.</string>
    <string name="settings_pin_mismatch">The two entries don\'t match.</string>
    <string name="settings_pin_set_note">PIN set. Only a scrambled verifier is stored — never the PIN itself.</string>
    <string name="settings_pin_removed_note">PIN removed.</string>
    <string name="settings_pin_removed_lock_note">PIN removed and the app lock turned off — set a new PIN to turn the lock back on.</string>
    <string name="settings_signout_explainer">Sign-out removes your password and settings from this phone and stops the periodic checks. Your mail itself stays on the server, untouched.</string>
    <string name="settings_signout_title">Sign out of Sentinel Mail?</string>
    <string name="settings_signout_body">Your password and settings are removed from this phone. Your mail stays on the server.</string>
    <string name="settings_signout_stay">Stay signed in</string>
    <string name="settings_about_line">Sentinel Safeguard LLC — your mail, from your own server, with no one in between.</string>

